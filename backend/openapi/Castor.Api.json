        "required": [
          "teryt",
          "name",
          "qualifiedName",
          "type",
          "powiat"
        ],
        "type": "object",
        "properties": {
          "teryt": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "qualifiedName": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "powiat": {
            "type": "string"
