        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "trackingCode": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "channel": {
            "type": "string"
          },
          "submittedOnBehalf": {
            "type": "boolean"
          },
          "description": {
            "type": "string"
          },
          "originalDescription": {
            "type": [
              "null",
              "string"
            ]
          },
          "municipality": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ProblemReportMunicipalityResponse"
              }
            ]
          },
          "challengeAreas": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProblemReportChallengeAreaResponse"
            }
          },
          "clarifyingQuestions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ClarifyingQuestionResponse"
            }
          },
          "awaitsAnswers": {
            "type": "boolean"
          },
          "isMatched": {
            "type": "boolean"
          },
          "hasAuthor": {
            "type": "boolean"
          },
          "matches": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MatchResponse"
            }
          },
          "hybrid": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/HybridResponse"
              }
            ]
          },
          "similarReports": {
            "$ref": "#/components/schemas/SimilarProblemReportsResponse"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
