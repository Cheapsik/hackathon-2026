            }
          }
        }
      },
      "HybridSourceResponse": {
        "required": [
          "innovationId",
          "title",
          "cardUrl"
        ],
        "type": "object",
        "properties": {
          "innovationId": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "cardUrl": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "MatchResponse": {
        "required": [
          "position",
          "score",
          "innovationId",
          "title",
          "shortDescription",
          "justification",
          "citedFields",
          "adaptation",
          "videoUrl",
          "cardUrl"
        ],
        "type": "object",
        "properties": {
          "position": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "score": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "innovationId": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "shortDescription": {
            "type": [
              "null",
              "string"
            ]
          },
          "justification": {
            "type": "string"
          },
          "citedFields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "adaptation": {
            "type": [
              "null",
              "string"
            ]
          },
          "videoUrl": {
            "type": [
              "null",
              "string"
            ]
          },
          "cardUrl": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
