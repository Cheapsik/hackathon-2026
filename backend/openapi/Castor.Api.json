        "required": [
          "id",
          "trackingCode",
          "status",
          "channel",
          "submittedOnBehalf",
          "description",
          "originalDescription",
          "municipality",
          "challengeAreas",
          "clarifyingQuestions",
          "awaitsAnswers",
          "isMatched",
          "hasAuthor",
          "matches",
          "hybrid",
          "similarReports",
          "createdAt"
