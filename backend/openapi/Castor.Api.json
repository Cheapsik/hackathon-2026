  "components": {
    "schemas": {
      "AnswerProblemReportQuestionsRequest": {
        "required": [
          "answers"
        ],
        "type": "object",
        "properties": {
          "answers": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            }
          }
        }
      },
      "AskFitAssistantRequest": {
        "required": [
          "message"
        ],
        "type": "object",
        "properties": {
          "message": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ClaimProblemReportRequest": {
        "required": [
          "trackingCode"
        ],
        "type": "object",
        "properties": {
          "trackingCode": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ClarifyingQuestionResponse": {
        "required": [
          "question",
          "answer"
        ],
        "type": "object",
        "properties": {
          "question": {
            "type": "string"
          },
          "answer": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "CreateFitAssessmentRequest": {
        "required": [
          "teryt",
          "recalculate"
        ],
        "type": "object",
        "properties": {
          "teryt": {
            "type": [
              "null",
              "string"
            ]
          },
          "recalculate": {
            "type": "boolean"
          }
        }
      },
      "CreateProblemReportRequest": {
        "required": [
          "description",
          "municipalityTeryt",
          "submittedOnBehalf",
          "dictated",
          "keepOriginalDescription"
        ],
        "type": "object",
        "properties": {
          "description": {
            "type": [
              "null",
              "string"
            ]
          },
          "municipalityTeryt": {
            "type": [
              "null",
              "string"
            ]
          },
          "submittedOnBehalf": {
            "type": "boolean"
          },
          "dictated": {
            "type": "boolean"
          },
          "keepOriginalDescription": {
            "type": "boolean"
          }
        }
      },
      "FitAssessmentMunicipalityResponse": {
        "required": [
          "teryt",
          "name",
          "powiat"
        ],
        "type": "object",
        "properties": {
          "teryt": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "powiat": {
            "type": "string"
          }
        }
      },
      "FitAssessmentResponse": {
        "required": [
          "id",
          "innovationId",
          "innovationTitle",
          "municipality",
          "dataYear",
          "fit",
          "summary",
          "unchanged",
          "toAdapt",
          "missing",
          "serviceProvider",
          "serviceForm",
          "scaleEstimate",
          "comparison",
          "createdAt",
          "updatedAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "innovationId": {
            "type": "string",
            "format": "uuid"
          },
          "innovationTitle": {
            "type": "string"
          },
          "municipality": {
            "$ref": "#/components/schemas/FitAssessmentMunicipalityResponse"
          },
          "dataYear": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "fit": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "unchanged": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "toAdapt": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "missing": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "serviceProvider": {
            "type": [
              "null",
              "string"
            ]
          },
          "serviceForm": {
            "type": [
              "null",
              "string"
            ]
          },
          "scaleEstimate": {
            "type": [
              "null",
              "string"
            ]
          },
          "comparison": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FitComparisonRowResponse"
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "FitAssistantMessageResponse": {
        "required": [
          "id",
          "role",
          "text",
          "createdAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "role": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "FitComparisonRowResponse": {
        "required": [
          "requirement",
          "indicatorName",
          "unit",
          "level",
          "value",
          "regionAverage",
          "year"
        ],
        "type": "object",
        "properties": {
          "requirement": {
            "type": "string"
          },
          "indicatorName": {
            "type": "string"
          },
          "unit": {
            "type": [
              "null",
              "string"
            ]
          },
          "level": {
            "type": "string"
          },
          "value": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
