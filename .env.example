# Copy to .env (kept out of git) and fill in. docker-compose.yml reads it; the backend also gets every
# Section__Key variable below as .NET configuration (Section:Key).

# Database password. The compose file builds ConnectionStrings__Castor from it. Set your own on a server.
POSTGRES_PASSWORD=

# Production reverse proxy listeners used by deploy/docker-compose.prod.yml.
HTTP_BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
HTTPS_BIND_ADDRESS=0.0.0.0
HTTPS_PORT=443

# LLM behind ILlmClient. Keep placeholder for deterministic local responses, or set openai and fill the model/key.
# The OpenAI adapter uses the Responses API. The key stays server-side and must never be committed.
Llm__Provider=placeholder
Llm__Model=
Llm__ApiKey=
Llm__BaseUrl=https://api.openai.com/v1/
Llm__MaxOutputTokens=4096
Llm__TimeoutSeconds=120

# Embeddings behind IEmbeddingClient — provider, model and size still to be decided (docs/TODO.md).
Embeddings__Provider=
Embeddings__Model=
Embeddings__ApiKey=
Embeddings__BaseUrl=
Embeddings__Dimensions=

# The first administrator: this account becomes ADMIN at start-up (created when missing). Use your own values.
Bootstrap__AdminEmail=
Bootstrap__AdminPassword=

# Seed import from data/seed. docker-compose.yml mounts it and turns the import on; locally Development does.
Seed__Path=
Seed__OnStartup=false

# Matching (SPEC 6.4): below this best score a hybrid is proposed; how many innovations the ranking gets
# (without embeddings the whole library, ~115).
Matching__HybridThreshold=50
Matching__CandidateLimit=150
Matching__MaxMatches=5

# Rate limit per client IP on public endpoints that call the language model.
RateLimiting__PublicAi__PermitLimit=10
RateLimiting__PublicAi__WindowSeconds=60

# Rate limit per client IP on public endpoints that open a problem report with its tracking code.
RateLimiting__TrackingCode__PermitLimit=30
RateLimiting__TrackingCode__WindowSeconds=60
